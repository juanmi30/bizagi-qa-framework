    "pasos": [
      {
        "paso": 2,
        "accion": "Ingrese al ambiente de bizagi con un usuario con rol \"Coordinador\" para poder validar la parametrica \"Mensajes Site AFI\"",
        "esperado": "Se debe cargar el ambiente correctamente",
        "verificaciones": [
          {
            "tipo": "bizagi-acceso",
            "rolRequerido": "Coordinador"
          }
        ]
      },
      {
        "paso": 3,
        "accion": "Valide en la parametrica \"Mensajes Site AFI\" y revise que las columnas de la parametrica correspondan correctamente",
        "esperado": "Se debe visualizar las columnas en la parametrica correctamente:\n\nCódigo (Texto / String)\nMensaje (Texto / String largo)\nEstado (Booleano)",
        "verificaciones": [
          {
            "tipo": "parametrica-columnas",
            "entidad": "Mensajes Site AFI",
            "busqueda": "mensaje",
            "columnas": [
              "Código",
              "Mensaje",
              "Estado"
            ],
            "tiposDato": {
              "Código": "Texto / String",
              "Mensaje": "Texto / String largo",
              "Estado": "Booleano"
            }
          }
        ]
      },
      {
        "paso": 4,
        "accion": "Valide en la parametrica \"Mensajes Site AFI\"  los mensajes a incluir y que sean los correctos",
        "esperado": "Se debe visualizar los registros en la parametrica correctamente:\n\nBúsqueda no exitosa en ninguna fuente: \"No encontramos información en las fuentes de búsqueda. Puedes ingresar la información correspondiente para continuar con el proceso\".\n\nServicio no disponible o timeout: \"No pudimos consultar tu información en este momento. Puedes ingresar la información para continuar con el proceso\".\n\nMotivo cancelación registraduría: \"La cédula se encuentra cancelada. Verifca el documento ingresado o intenta con otra información\".",
        "verificaciones": [
          {
            "tipo": "parametrica-mensajes",
            "entidad": "Mensajes Site AFI",
            "busqueda": "mensaje",
            "columnaMensaje": "Mensaje",
            "mensajes": [
              {
                "descripcion": "Búsqueda no exitosa en ninguna fuente",
                "texto": "No encontramos información en las fuentes de búsqueda. Puedes ingresar la información correspondiente para continuar con el proceso"
              },
              {
                "descripcion": "Servicio no disponible o timeout",
                "texto": "No pudimos consultar tu información en este momento. Puedes ingresar la información para continuar con el proceso"
              },
              {
                "descripcion": "Motivo cancelación registraduría",
                "texto": "La cédula se encuentra cancelada. Verifca el documento ingresado o intenta con otra información"
              }
            ]
          }
        ]
      },
      {
        "paso": 5,
        "accion": "Ingrese al Portal de afiliaciones de test de Colsubsidio mediante el siguiente link \"https://transacciones.colsubsidio.com/afiliaciones-en-linea/qa/home\"",
        "esperado": "El ambiente de pruebas carga correctamente permitiendo el inicio del trámite",
        "verificaciones": [
          {
            "tipo": "portal-apertura"
          }
        ]
      },
      {
        "paso": 6,
        "accion": "Inicie un proceso de afiliación para un tipo de aportante \"Empleador\" juridico que exista en RUES y que NO este afiliado a colsubsidio",
        "esperado": "Se debe iniciar el proceso con un número de caso enviado al correo electronico",
        "verificaciones": [
          {
            "tipo": "portal-caso-creado"
          },
          {
            "tipo": "condicion",
            "entidad": {
              "tipo": "notificacion",
              "id": "notificacion-inicio-tramite-correo"
            },
            "expectativa": {
              "tipo": "emitida"
            }
          }
        ]
      },
      {
        "paso": 7,
        "accion": "El proceso iniciara las validaciones de GIASS y RUES",
        "esperado": "Las validaciones deben ser correctas y la integración de GIASS obtendra la información correspondiente y  el proceso avanza correctamente \n\nEl proceso continuara correctamente y llegara a la actividad \"Registrar información del cliente\"",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-ingresa-informacion-empresa",
            "expectativa": {
              "titulo": {
                "texto": "Ingresa la información de la empresa"
              }
            }
          },
          {
            "tipo": "condicion",
            "entidad": {
              "tipo": "integracion",
              "id": "integracion-giass"
            },
            "expectativa": {
              "tipo": "resultado",
              "igual": "exito"
            }
          },
          {
            "tipo": "condicion",
            "entidad": {
              "tipo": "integracion",
              "id": "integracion-rues"
            },
            "expectativa": {
              "tipo": "resultado",
              "igual": "exito"
            }
          },
          {
            "tipo": "condicion",
            "entidad": {
              "tipo": "actividad",
              "id": "actividad-registrar-informacion-cliente"
            },
            "expectativa": {
              "tipo": "alcanzada"
            }
          }
        ]
      },
      {
        "paso": 8,
        "accion": "En la actividad \"Registrar información cliente\" valide la correcta unificación de las pantallas \"Datos generales\" con la pantalla \"Ingresa la información de la empresa\"",
        "esperado": "Se debera visualizar el correcto ajuste en el primer formulario de la actividad, evidenciando los campos correctos (Ver REQ)",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-ingresa-informacion-empresa",
            "expectativa": {
              "titulo": {
                "texto": "Ingresa la información de la empresa",
                "unico": true
              }
            }
          }
        ]
      },
      {
        "paso": 9,
        "accion": "En la actividad \"Registrar información cliente\" valide en la pantalla \"Ingresa la información de la empresa\" la eliminación del campo \"Tipo de sociedad\"",
        "esperado": "Ya no se visualizara el campo en el primer formulario de la actividad correctamente",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-ingresa-informacion-empresa",
            "expectativa": {
              "etiquetasAusentes": [
                "Tipo de sociedad"
              ]
            }
          }
        ]
      },
      {
        "paso": 10,
        "accion": "Valide la misma funcionalidad y diseño en la versión Mobile",
        "esperado": "Se debe visualizar correctamente el prototipo en la versión Mobile",
        "dispositivo": "mobile",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-ingresa-informacion-empresa",
            "expectativa": {
              "titulo": {
                "texto": "Ingresa la información de la empresa",
                "unico": true
              },
              "etiquetasAusentes": [
                "Tipo de sociedad"
              ]
            }
          },
          {
            "tipo": "diseno",
            "referencia": "figma"
          }
        ]
      },
      {
        "paso": 11,
        "accion": "En la actividad \"Registrar información cliente\" valide el correcto ajuste de los formularios, hasta llegar a la actividad \"Representante legal\"",
        "esperado": "Se debe visualizar el correcto orden de los formularios a mostrar, que seran lo siguientes:\n\nIngresa la información de la empresa (información de identificación e información economica)\nInformación de contacto\nIngresa la información asociada a la dirección\nRepresentante legal",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-ingresa-informacion-empresa",
            "expectativa": {
              "titulo": {
                "texto": "Ingresa la información de la empresa"
              }
            }
          },
          {
            "tipo": "pantalla",
            "pantalla": "informacion-contacto",
            "expectativa": {
              "titulo": {
                "texto": "Ingresa tu información de contacto"
              }
            }
          },
          {
            "tipo": "accion",
            "accion": "avanzar",
            "hasta": "pantalla-direccion"
          },
          {
            "tipo": "accion",
            "accion": "avanzar",
            "hasta": "pantalla-representante-legal"
          }
        ]
      },
      {
        "paso": 12,
        "accion": "En la actividad \"Registrar información cliente\" valide en la pantalla \"Representante legal\" la información del representante legal retornada de RUES",
        "esperado": "El formulario precargara unicamente el número de identificación retornado de la integración y debera ser editable\n\nEl campo tendra un tooltip con el siguiente mensaje: \"Este dato proviene de fuentes oficiales y no requiere modificación manual.\"\n\nSolo se visualiza los campos Tipo de identificación y Numero de identificación\n\nEl campo tipo de identificación estara vacio",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-representante-legal",
            "expectativa": {
              "camposVisiblesExactos": [
                "representante-legal-tipo-identificacion",
                "representante-legal-numero-identificacion"
              ],
              "campos": [
                {
                  "campo": "representante-legal-numero-identificacion",
                  "precargado": true,
                  "editable": true,
                  "tooltip": "Este dato proviene de fuentes oficiales y no requiere modificación manual."
                },
                {
                  "campo": "representante-legal-tipo-identificacion",
                  "vacio": true
                }
              ]
            }
          }
        ]
      },
      {
        "paso": 13,
        "accion": "Valide la misma funcionalidad y diseño en la versión Mobile",
        "esperado": "Se debe visualizar correctamente el prototipo en la versión Mobile",
        "dispositivo": "mobile",
        "verificaciones": [
          {
            "tipo": "pantalla",
            "pantalla": "pantalla-representante-legal",
            "expectativa": {
              "camposVisiblesExactos": [
                "representante-legal-tipo-identificacion",
