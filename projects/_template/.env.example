# === Proyecto Bizagi Cloud: <NOMBRE> ===
# Copia este archivo a ".env" (sin .example) y completa los valores reales.
BIZAGI_BASE_URL=https://<tu-proyecto>.bizagi.com
BIZAGI_USER=usuario.qa
BIZAGI_PASSWORD=cambia_esto
BIZAGI_QUICK_USER=usuario.qa

# Etiqueta con la que el Work Portal muestra el número de caso (para los hazards de
# bandeja/asignación). Por defecto "Número de caso"; cámbiala si tu portal usa otra
# (ej. "Radicado", "Case number"). Alternativa: BIZAGI_CASE_NUMBER_SELECTOR=<selector CSS>.
BIZAGI_CASE_NUMBER_LABEL=Número de caso

# Extensión D: si el portal pide elegir DOMINIO antes de usuario/clave, ponlo aquí
# (valor u opción visible del select). Si no aplica, deja la línea comentada.
# BIZAGI_LOGIN_DOMINIO=midominio

# Extensión G — esperas (los ambientes de integración son volubles, se ajustan por proyecto):
#  - ESPERA_ACCION_SEGUNDOS: espera implícita tras CADA botón de avance (default 90).
#  - ESPERA_INTEGRACION_MINUTOS: default de los pasos con "esperar_integracion:" (default 5).
ESPERA_ACCION_SEGUNDOS=90
ESPERA_INTEGRACION_MINUTOS=5
