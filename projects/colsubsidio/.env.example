# === Proyecto Bizagi Cloud: Colsubsidio ===
# Copia este archivo a ".env" (sin .example) y completa/actualiza los valores reales.
# El .env está ignorado por Git (projects/**/.env). Nunca subas credenciales.
BIZAGI_BASE_URL=https://test-procesosdigitales-colsubsidio.bizagi.com

# --- Login por Work Portal (UI) ---
# Este portal pide DOMINIO (select #domain) + usuario + clave (Extensión D).
BIZAGI_LOGIN_MODO=estandar
BIZAGI_LOGIN_DOMINIO=domain
USUARIO_admin=<usuario>
CLAVE_admin=<clave>
# Nombre de usuario visible en Bizagi del administrador QA: destino de reasignación (bizagiQaSupport) y
# usuario creador en create-case/credito.json ("${env:...}"). No se versiona: con la clave actual sería deducible.
COLSUBSIDIO_USUARIO_ADMINISTRADOR=<usuario-administrador-qa>
# Etiqueta con la que el Work Portal muestra el número de caso (verificado: "Número de Solicitud").
BIZAGI_CASE_NUMBER_LABEL=Número de Solicitud

# --- Esperas de integración (Extensión G) ---
ESPERA_ACCION_SEGUNDOS=90
ESPERA_INTEGRACION_MINUTOS=5

# --- Modo servicio (API OData) ---
BIZAGI_API_URL=https://test-procesosdigitales-colsubsidio.bizagi.com
# El ambiente de pruebas usa un Bearer token preemitido:
BIZAGI_API_TOKEN=<token-bearer-de-pruebas>
# Alternativa OAuth (si más adelante se entrega una app con Client ID/Secret):
# BIZAGI_API_CLIENT_ID=
# BIZAGI_API_SECRET=
BIZAGI_API_TIMEOUT_MS=30000
# Process IDs de los Create Case confirmados:
BIZAGI_PROCESS_ID_CREDITO=0188d3ec-f208-4653-be77-788fc76e370c
BIZAGI_PROCESS_ID_AFILIACIONES=d5e224d0-4f05-4ebb-9a61-f4cafdc9ed63
# Las pruebas reales crean casos en el ambiente test; habilitar explícitamente.
BIZAGI_RUN_REAL_API=false
# Overrides opcionales para repetir Create Case con datos nuevos sin editar los recursos:
# BIZAGI_CREDITO_NUMERO_IDENTIFICACION=
# BIZAGI_AFILIACIONES_NUMERO_IDENTIFICACION=
# BIZAGI_AFILIACIONES_CORREO=
