{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@shared": ["shared/index.ts"],
      "@shared/*": ["shared/*"]
    },
    "types": ["node"]
  },
  "include": ["shared", "projects", "playwright.config.ts"]
}
