# === Proyecto Bizagi Cloud: Seguros del Estado — Centro de Expedición (SDE-CEL) ===
# Copia este archivo a ".env" (sin .example) y completa los valores reales.
# El .env está ignorado (.gitignore: projects/**/.env). NUNCA subas claves ni datos reales.
# No reutilices usuarios/claves/datos de Colsubsidio, CONPRE ni Demo.
# Qué significa cada dato: data/datasets.yaml. La prueba @unit verifica que este archivo y el registro coincidan.

# URL de QA citada en las matrices (verificada accesible: login con Dominio + Usuario + Contraseña).
BIZAGI_BASE_URL=https://test-aiprocesos-sde.bizagi.com

# El portal SDE pide primero el DOMINIO y luego usuario/clave → modo "estandar".
BIZAGI_LOGIN_MODO=estandar
# Dominio por defecto (valor del <select id="domain">). Valores observados en QA el 2026-10-07:
#   domain (Bizagi) | externos | segurosdelestado.com
# Cada usuario lógico puede sobrescribirlo con DOMINIO_<alias>.
BIZAGI_LOGIN_DOMINIO=

# --- Usuarios lógicos por ROL (los escenarios solo usan el alias) ---
# Intermediario que radica (HU06 inicio / HU03 Completar Información).
USUARIO_intermediario=
CLAVE_intermediario=
DOMINIO_intermediario=
# Analista Centro de Expedición (HU06 Estructurar Información; Requirement 230849).
USUARIO_analista=
CLAVE_analista=
DOMINIO_analista=
# (Fase 3) Intermediario con alerta bloqueante — HU03-CP09.
USUARIO_intermediario_alerta=
CLAVE_intermediario_alerta=
DOMINIO_intermediario_alerta=

# Número de caso: etiqueta visible o selector CSS (calibrar en la primera corrida).
BIZAGI_CASE_NUMBER_LABEL=Número de caso
# BIZAGI_CASE_NUMBER_SELECTOR=

# Esperas (QA con integraciones SISE / Worker AI):
ESPERA_ACCION_SEGUNDOS=90
ESPERA_INTEGRACION_MINUTOS=8

# Exploración de calibración del DOM (tests/exploracion.real.spec.ts). 1 = activa.
SDE_EXPLORAR=0

# =================== DATOS DE PRUEBA (solo valores provistos por QA) ===================
# --- CFG-PROCESO (todos los CP) — valores públicos verificados en QA el 2026-10-08 ---
SDE_PROCESO_RADICACION=Gestión Solicitudes Centro Expedición
SDE_PROCESO_CATEGORIA=App > Processes > Centro de Expedición
# Compartido por varios datasets
SDE_SUCURSAL=

# --- FASE 1 · HU06-CP05 (INI-INDIVIDUAL-RUTA) ---
SDE_RUTA_LINEA=
SDE_RUTA_RAMO=
SDE_RUTA_MOVIMIENTO=
SDE_RUTA_FORMA_CONSULTA=
SDE_RUTA_CRITERIO_CAMPO=
SDE_RUTA_CRITERIO_VALOR=

# --- FASE 1 · HU03-CP02 (POL-AUTOS-VIGENTE) ---
SDE_AUTOS_RAMO=
SDE_AUTOS_MOVIMIENTO=
SDE_AUTOS_POLIZA=
# Clave intermediario de USUARIO_intermediario (la póliza SISE debe pertenecer a esta clave)
SDE_INTERMEDIARIO_CLAVE=

# --- FASE 1 · HU06-CP01 (INI-GENERALES-MASIVO, EST-FILA-GENERALES-PN) ---
SDE_GEN_RAMO=

# --- Documentos obligatorios parametrizados (DOCS-OBLIGATORIOS) ---
SDE_DOCS_GENERALES_MASIVO=
SDE_DOCS_INDIVIDUAL=

# --- FASE 2 ---
SDE_PLACA_MULTIPOLIZA=
SDE_PLACA_MULTIPOLIZA_N=
SDE_GEN_POLIZA=
SDE_TOMADOR_EXISTENTE_TIPO=
SDE_TOMADOR_EXISTENTE_NUM=
SDE_TOMADOR_INEXISTENTE_TIPO=
SDE_TOMADOR_INEXISTENTE_NUM=
SDE_CUMPL_MOVIMIENTO=
SDE_CUMPL_RAMO_CON_RCE=
SDE_CUMPL_POLIZA_CON_RCE=
SDE_CUMPL_RAMO_SIN_RCE=
SDE_CUMPL_POLIZA_SIN_RCE=
SDE_CUMPL_RAMO_RCE=
SDE_CUMPL_POLIZA_RCE=

# --- FASE 3 ---
SDE_CUMPL_POLIZA_RCE_INEXISTENTE=
SDE_POLIZA_OTRO_INTERMEDIARIO=
SDE_CARTA_NOMBRAMIENTO_ARCHIVO=
SDE_POLIZA_INEXISTENTE=
